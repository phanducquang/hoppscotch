{
  "realm": "hoppscotch",
  "displayName": "Hoppscotch OIDC Development",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "hoppscotch",
      "name": "Hoppscotch",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3170/v1/auth/oidc/callback"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3100"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "oidc-user",
      "enabled": true,
      "emailVerified": true,
      "email": "oidc-user@example.com",
      "firstName": "OIDC",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    }
  ]
}
