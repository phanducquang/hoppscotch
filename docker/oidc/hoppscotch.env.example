# Development-only configuration for docker/oidc/compose.yml.
DATABASE_URL=postgresql://postgres:testpass@postgres:5432/hoppscotch?connect_timeout=300
DATA_ENCRYPTION_KEY=01234567890123456789012345678901

WHITELISTED_ORIGINS=http://localhost:3170,http://localhost:3000,http://localhost:3100
VITE_ALLOWED_AUTH_PROVIDERS=OIDC

OIDC_DISPLAY_NAME=Keycloak
OIDC_ISSUER=http://keycloak.local:8080/realms/hoppscotch
OIDC_CLIENT_ID=hoppscotch
OIDC_CLIENT_SECRET=change-me
OIDC_CALLBACK_URL=http://localhost:3170/v1/auth/oidc/callback
OIDC_SCOPE=openid profile email

VITE_BASE_URL=http://localhost:3000
VITE_SHORTCODE_BASE_URL=http://localhost:3000
VITE_ADMIN_URL=http://localhost:3100
VITE_BACKEND_GQL_URL=http://localhost:3170/graphql
VITE_BACKEND_WS_URL=ws://localhost:3170/graphql
VITE_BACKEND_API_URL=http://localhost:3170/v1

ENABLE_SUBPATH_BASED_ACCESS=false
TRUST_PROXY=false
